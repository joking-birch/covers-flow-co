---
import { plans, plansNote } from '../data/plans';

/* standalone: used by the dedicated /get-started page, which wants just
   the toggle button (no "Not sure where you stand?" teaser line) styled
   as a large, attention-getting blink button rather than the homepage's
   small inline one — everything else (steps, typewriter, hash-arrival
   handling) is identical and fully reused as-is. */
const { standalone = false } = Astro.props;

/* Typed out letter-by-letter in the gap between the quickstart surface and
   OperatorStrip below (see the typewriter script), independent of the
   Get Started flow entirely — it shows up on scroll whether or not the
   button has been pressed, and lives only here, never inside the box. */
const aboutText = "CoversFlow is a technical SEO and AI-search practice for restaurants and hospitality, run by someone who worked the floor for twenty years before doing this full time. We fix the plumbing — schema, speed, Google Business Profile — so guests find the room, not just the website.";
const aboutChars = aboutText.split('');
---

<section class="quickstart">
  <div class="quickstart__inner">
   <div class="quickstart__surface" data-qs-surface>
    {!standalone && (
      <p class="quickstart__line">Not sure where you stand? <span class="quickstart__line-accent">Get a free website audit.</span></p>
    )}
    <button
      type="button"
      class={`quickstart__toggle${standalone ? ' quickstart__toggle--standalone' : ''}`}
      id="get-started"
      data-qs-toggle
      data-qs-blink={standalone ? true : undefined}
      aria-expanded="false"
      aria-controls="quickstart-panel"
    >
      Get Started
    </button>

    <div class="quickstart__grow" data-qs-grow>
      <div class="quickstart__panel" id="quickstart-panel" data-qs-panel data-step="gate">
       <div class="quickstart__box" data-qs-box>

        <div class="qs-step" data-qs-step="gate">
          <p class="qs-step__prompt">Do you currently have a website?</p>
          <div class="qs-step__actions">
            <button type="button" class="btn btn--outline" data-qs-goto="audit">Yes</button>
            <button type="button" class="btn btn--outline" data-qs-goto="plans">No</button>
          </div>
        </div>

        <div class="qs-step" data-qs-step="audit">
          <button type="button" class="qs-back" data-qs-goto="gate">← Back</button>
          <h3>Let's take a look</h3>
          <p class="qs-step__lead">Tell us where to find you and what you're working with.</p>
        </div>

        <div class="qs-step" data-qs-step="plans">
          <button type="button" class="qs-back" data-qs-goto="gate">← Back</button>
          <h3>Let's build one</h3>
          <div class="qs-plans">
            {plans.map((p) => (
              <button type="button" class="qs-plan" data-qs-plan={p.id} data-qs-goto="contact">
                <span class="qs-plan__title">{p.title}</span>
                <span class="qs-plan__price">{p.price}</span>
                <span class="qs-plan__body">{p.body}</span>
              </button>
            ))}
          </div>
          <p class="qs-plans__note">{plansNote}</p>
        </div>

        <div class="qs-step" data-qs-step="contact">
          <button type="button" class="qs-back" data-qs-goto="gate">← Back</button>
          <h3 data-qs-contact-heading>Tell us where to reach you</h3>
          <p class="qs-step__lead" data-qs-contact-lead></p>
        </div>

        <div class="qs-step" data-qs-step="done">
          <h3>Thanks, we'll be in touch.</h3>
          <p class="qs-step__lead">
            You can also reach us directly at
            <a href="mailto:ian@ianwhitewrites.com">ian@ianwhitewrites.com</a>.
          </p>
        </div>

        <!-- Single form, all fields always present (Netlify scans the built static HTML for this),
             visibility of individual fields is driven by data-step below. -->
        <form
          name="intake"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          data-qs-form
        >
          <input type="hidden" name="form-name" value="intake" />
          <input type="hidden" name="path" data-qs-path value="" />
          <p class="qs-honeypot" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="qs-fields">
            <label class="qs-field">
              <span>Name</span>
              <input type="text" name="name" required />
            </label>
            <label class="qs-field">
              <span>Business name</span>
              <input type="text" name="business" required />
            </label>
            <label class="qs-field">
              <span>Email</span>
              <input type="email" name="email" required />
            </label>
            <label class="qs-field">
              <span>Phone</span>
              <input type="tel" name="phone" />
            </label>
            <label class="qs-field qs-field--website" data-qs-field="website">
              <span>Website URL</span>
              <input type="url" name="website" placeholder="https://" />
            </label>
            <label class="qs-field qs-field--wide">
              <span>Message</span>
              <textarea name="message" rows="3"></textarea>
            </label>
          </div>

          <div class="qs-fields__actions" data-qs-field="submit">
            <button type="submit" class="btn" data-qs-submit>Request my free audit</button>
          </div>
        </form>

        <p class="qs-error" data-qs-error hidden>Something went wrong sending that. Try again, or email us directly.</p>
       </div>
      </div>
    </div>
   </div>

   <!-- Independent of the surface above: lives in the plain white gap
        between it and OperatorStrip. Scroll is arrested (lenis.stop()) the
        moment the hero clears and a GSAP tween reveals the paragraph over
        ~2.5s, then releases (lenis.start()) — generous padding gives it a
        deliberately prominent, centered place in that gap rather than a
        thin line of text. Shows up on scroll regardless of whether Get
        Started has been pressed, and never appears inside the box/panel
        itself. -->
   <p class="quickstart__about">
     <span class="quickstart__about-chars" data-qs-typewriter aria-hidden="true">
       {aboutChars.map((c) => <span class="qs-char">{c}</span>)}<span class="quickstart__caret" data-qs-caret></span>
     </span>
     <span class="quickstart__about-sr">{aboutText}</span>
   </p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* astro:page-load, not top-level: this module only executes once per
     session (ES module caching), but ClientRouter lets a visitor return to
     "/" via soft navigation. Re-binding on every page-load event (fired for
     the initial load too) is what makes the widget open/submit correctly
     again on a revisit, not just the first time this page is seen. */
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.quickstart');
    if (!root) return;

    /* This is the only ScrollTrigger user on the site — on a soft-nav
       revisit the old one(s) would otherwise reference now-detached DOM
       from the previous page-load cycle and keep reserving scroll space
       for an element nobody can see. Clear the slate before creating a
       fresh one below. */
    ScrollTrigger.getAll().forEach((t) => t.kill());

    /* Layout.astro's Lenis instance smooths the real document scroll (no
       wrapper/transform virtual-scroll mode), so ScrollTrigger reading
       native scroll position already works — this just keeps it tightly
       synced to Lenis's own per-frame scroll events rather than whatever
       the browser's native (sometimes throttled) scroll event delivers. */
    const lenis = (window as any).lenis;
    if (lenis) lenis.on('scroll', ScrollTrigger.update);

    const surface = root.querySelector<HTMLElement>('[data-qs-surface]')!;
    const typewriter = root.querySelector<HTMLElement>('[data-qs-typewriter]')!;
    const caret = root.querySelector<HTMLElement>('[data-qs-caret]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-qs-toggle]')!;
    const grow = root.querySelector<HTMLElement>('[data-qs-grow]')!;
    const panel = root.querySelector<HTMLElement>('[data-qs-panel]')!;
    const box = root.querySelector<HTMLElement>('[data-qs-box]')!;
    const form = root.querySelector<HTMLFormElement>('[data-qs-form]')!;
    const pathInput = root.querySelector<HTMLInputElement>('[data-qs-path]')!;
    const websiteField = root.querySelector<HTMLElement>('[data-qs-field="website"]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-qs-submit]')!;
    const contactHeading = root.querySelector<HTMLElement>('[data-qs-contact-heading]')!;
    const contactLead = root.querySelector<HTMLElement>('[data-qs-contact-lead]')!;
    const errorMsg = root.querySelector<HTMLElement>('[data-qs-error]')!;

    const copyByPath: Record<string, { heading: string; lead: string; submit: string }> = {
      audit: {
        heading: 'Let’s take a look',
        lead: 'Tell us where to find you and what you’re working with.',
        submit: 'Request my free audit',
      },
      standard: {
        heading: 'Great, tell us where to reach you',
        lead: 'You picked Standard. We’ll follow up to get started.',
        submit: 'Get in touch',
      },
      'mid-tier': {
        heading: 'Great, tell us where to reach you',
        lead: 'You picked Mid-tier. We’ll follow up to get started.',
        submit: 'Get in touch',
      },
      custom: {
        heading: 'Let’s talk design',
        lead: 'Tell us where to reach you and we’ll set up a call.',
        submit: 'Get in touch',
      },
    };

    const setOpen = (v: boolean) => {
      toggle.setAttribute('aria-expanded', String(v));
      grow.classList.toggle('quickstart__grow--open', v);
      /* The surface merges the headline/button area with the gray box into
         one fluid panel on open; the button fades/collapses out of it
         (see CSS) and goes inert so it can't be tabbed to or clicked while
         invisible. */
      surface.classList.toggle('quickstart__surface--open', v);
      toggle.inert = v;
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* The /get-started page's standalone toggle: an asymmetric "pop" — a
       long calm rest at rust, then a quick pop to cream (with a subtle
       scale-up, via CSS transition on [data-blink-phase]) before settling
       back — rather than a steady, equal-time blink. Chained setTimeout
       (not setInterval) is what makes the two phases' hold times able to
       differ at all. Pauses (freezing on whichever phase it's in) while
       hovered/focused — CSS then shows that frozen phase's inverse colors,
       so hovering always reads as "the opposite of its current state."
       Marked via data-qs-blink only when standalone (see markup), so the
       normal homepage toggle is untouched. */
    if (toggle.hasAttribute('data-qs-blink')) {
      if (reduceMotion.matches) {
        toggle.dataset.blinkPhase = 'a';
      } else {
        const REST_MS = 2200;
        const POP_MS = 500;
        let phase: 'a' | 'b' = 'a';
        let blinkTimer: ReturnType<typeof setTimeout>;
        toggle.dataset.blinkPhase = phase;
        const schedule = () => {
          blinkTimer = setTimeout(() => {
            phase = phase === 'a' ? 'b' : 'a';
            toggle.dataset.blinkPhase = phase;
            schedule();
          }, phase === 'a' ? REST_MS : POP_MS);
        };
        schedule();
        const pause = () => clearTimeout(blinkTimer);
        const resume = () => schedule();
        toggle.addEventListener('pointerenter', pause);
        toggle.addEventListener('pointerleave', resume);
        toggle.addEventListener('focus', pause);
        toggle.addEventListener('blur', resume);
      }
    }

    const chars = Array.from(typewriter.querySelectorAll<HTMLElement>('.qs-char'));
    const hero = document.querySelector<HTMLElement>('.hero');

    /* Plays once per browser session (sessionStorage), same mechanism as
       IntroLoader's cf-intro-seen flag. Without this, a soft-nav round trip
       — e.g. open a space page, click "request my free audit", land back on
       "/" — tears down and recreates the ScrollTrigger on every page-load
       (see the getAll().kill() above), so GSAP's own `once: true` can't
       remember a prior play across that cycle on its own. */
    const TYPEWRITER_SESSION_KEY = 'cf-typewriter-seen';
    const alreadySeen = sessionStorage.getItem(TYPEWRITER_SESSION_KEY) === '1';

    const REVEAL_SECONDS = 2.5;

    /* Arrest scrolling outright (the same lenis.stop()/start() lock
       IntroLoader and SiteMenu already use for their own overlay states —
       proven to actually block Lenis-driven scroll, unlike CSS
       overflow:hidden alone) and run a GSAP tween over ~2.5s that reveals
       the characters, releasing the lock on completion. Entirely
       independent of the Get Started flow — it shows up whether or not
       the button has been pressed, and once shown, stays shown; nothing
       here ever hides or interrupts it. Shared by both trigger paths
       below (hero-scroll on the homepage, immediate on a heroless page). */
    const playTypewriter = () => {
      sessionStorage.setItem(TYPEWRITER_SESSION_KEY, '1');
      lenis?.stop();
      caret.classList.add('is-typing');
      chars[0].before(caret); // starting position: right before the first character
      const progress = { n: 0 };
      let lastTarget = 0;
      gsap.timeline({
        onComplete: () => {
          caret.classList.remove('is-typing');
          lenis?.start();
        },
      }).to(progress, {
        n: chars.length,
        duration: REVEAL_SECONDS,
        ease: 'none',
        onUpdate: () => {
          const target = Math.round(progress.n);
          if (target === lastTarget) return;
          for (let i = 0; i < chars.length; i++) chars[i].classList.toggle('is-visible', i < target);
          /* Moves the caret itself in the DOM to sit right after the most
             recently revealed character — since these are normal inline
             spans (not absolutely positioned), this naturally tracks the
             current line and wraps with the text, rather than sitting
             fixed at the end of the full (already fully laid-out, just
             invisible) paragraph. Only moves on an actual target change,
             not every frame, so it doesn't restart the blink animation
             unnecessarily. */
          chars[target - 1].after(caret);
          lastTarget = target;
        },
      });
    };

    if (!reduceMotion.matches && chars.length > 0 && !alreadySeen) {
      if (hero) {
        ScrollTrigger.create({ trigger: hero, start: 'bottom top', once: true, onEnter: playTypewriter });
      } else {
        /* No hero on this page (e.g. /get-started) — nothing to scroll
           past, so just play on load instead. Same session-wide gate as
           above means it still only plays once, period, no matter which
           page a visitor sees it on first. */
        playTypewriter();
      }
    } else {
      chars.forEach((c) => c.classList.add('is-visible'));
    }

    let resizeT: ReturnType<typeof setTimeout>;

    const goto = (step: string) => {
      const fromHeight = box.offsetHeight;

      panel.dataset.step = step;
      const isAudit = step === 'audit';
      const isContact = step === 'contact';
      websiteField.hidden = !isAudit;
      const websiteInput = websiteField.querySelector('input');
      if (websiteInput) (websiteInput as HTMLInputElement).required = false;

      if (isAudit) {
        pathInput.value = 'audit';
        submitBtn.textContent = copyByPath.audit.submit;
      } else if (isContact) {
        const path = pathInput.value || 'standard';
        const copy = copyByPath[path] ?? copyByPath.standard;
        contactHeading.textContent = copy.heading;
        contactLead.textContent = copy.lead;
        submitBtn.textContent = copy.submit;
      }

      /* The bordered box resizes to whichever step is now visible: measure
         the natural height post-switch, hold at the old height, then
         transition to it — same auto-height-transition trick used for the
         panel's own open/close, just JS-driven since this also has to react
         to content that changes (not just show/hide). */
      const toHeight = box.scrollHeight;
      box.style.height = `${fromHeight}px`;
      void box.offsetHeight; // force reflow so the browser has a start point to animate from
      box.style.height = `${toHeight}px`;
      clearTimeout(resizeT);
      resizeT = setTimeout(() => { box.style.height = ''; }, 480);
    };

    root.querySelectorAll<HTMLElement>('[data-qs-goto]').forEach((el) => {
      el.addEventListener('click', () => {
        const plan = el.getAttribute('data-qs-plan');
        if (plan) pathInput.value = plan;
        goto(el.getAttribute('data-qs-goto')!);
      });
    });

    /* External CTAs elsewhere on the page (e.g. the pricing section's "Get
       my free audit") link to #get-started for the native scroll-to, and
       also carry this attribute to open the panel straight to the audit
       step rather than making the visitor answer the gate question again. */
    document.querySelectorAll<HTMLElement>('[data-qs-open-audit]').forEach((el) => {
      el.addEventListener('click', () => {
        setOpen(true);
        goto('audit');
      });
    });

    /* Same CTA also appears on the space and about pages (space-content.ts,
       about.astro), where it links to "/#get-started" — a navigation to this
       page, not a click here, so the listener above never fires. Catch that
       arrival instead: a page-load that already carries the hash means a
       visitor landed here specifically to start the audit. */
    if (location.hash === '#get-started') {
      setOpen(true);
      goto('audit');
    }

    /* Same idea, but for a specific website-build plan — each plan's own
       page (src/pages/plans/[plan].astro) carries this attribute with the
       plan's id as its value, pre-selecting that plan and jumping to the
       contact step rather than making the visitor pick again from the
       plans list. copyByPath (above) already keys its heading/lead/submit
       text by plan id, so setting pathInput.value here is the only piece
       needed for goto('contact') to pick up the right copy. */
    document.querySelectorAll<HTMLElement>('[data-qs-open-plan]').forEach((el) => {
      el.addEventListener('click', () => {
        const plan = el.getAttribute('data-qs-open-plan');
        if (plan) pathInput.value = plan;
        setOpen(true);
        goto('contact');
      });
    });

    /* Cross-page arrival version of the above — a plan page's CTA links to
       "/#plan-<id>", a navigation to this page rather than a click here,
       so the listener above never fires for that case either. Unlike
       "#get-started" (which matches the toggle's own id, so the browser's
       native hash-scroll already lands there on arrival), "#plan-<id>"
       matches no element, so nothing scrolls by default — explicitly
       scroll to the toggle ourselves, or the form opens off-screen above
       the fold with nothing visible to show for it. */
    const planHashMatch = location.hash.match(/^#plan-(.+)$/);
    if (planHashMatch) {
      pathInput.value = planHashMatch[1];
      setOpen(true);
      goto('contact');
      toggle.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.hidden = true;
      submitBtn.disabled = true;
      const body = new URLSearchParams(new FormData(form) as any).toString();
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(`Status ${res.status}`);
        goto('done');
      } catch {
        errorMsg.hidden = false;
        submitBtn.disabled = false;
      }
    });
  });
</script>

<style>
  .quickstart {
    max-width: 1080px;
    margin: 0 auto;
    /* Bottom padding keeps this section's content clear of OperatorStrip's
       gray band below — both this section's own surface (below, once open)
       and that strip use the same --paper-2 fill, so without a deliberate
       gap here they'd visually merge into one block. Baseline var(--s-7) (48px),
       +10% per direction. */
    padding: var(--s-6) var(--s-5) 53px;
  }
  .quickstart__inner { text-align: center; }

  /* The merged panel: transparent and full natural width while closed (so
     it's invisible and doesn't affect layout), then on open it fades to
     the same --paper-2 fill as OperatorStrip's banner below and gains the
     padding that reads as "a box" — width is fixed at all times (rather
     than transitioning from auto), since width can't transition smoothly
     from an implicit auto value; only background/padding animate, which
     is what actually reads as "the gray growing in." Capped at the
     section's own 1080px column so it never overshoots on very wide
     screens. */
  .quickstart__surface {
    width: calc(100vw - 500px);
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
    border-radius: var(--radius-md);
    background: transparent;
    transition: background var(--dur) var(--ease), padding var(--dur) var(--ease);
  }
  .quickstart__surface--open {
    background: var(--paper-2);
    /* Top value is the "bit of additional padding between the hero and
       the text" once opened — closed state has none here, so the
       headline's position is unchanged until this triggers. */
    padding: var(--s-6) var(--s-6) var(--s-7);
  }
  @media (max-width: 1200px) {
    .quickstart__surface { width: 100%; }
    .quickstart__surface--open { padding: var(--s-5) var(--s-5) var(--s-6); }
  }
  .quickstart__line {
    margin: 0 auto var(--s-6);
    max-width: 34ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }
  .quickstart__line-accent { color: var(--rust); }

  .quickstart__toggle {
    display: inline-block;
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: var(--tracking-tight);
    cursor: pointer;
    max-height: 60px;
    overflow: hidden;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease), max-height var(--dur) var(--ease),
      opacity var(--dur-fast) var(--ease), padding var(--dur) var(--ease), border-width var(--dur) var(--ease);
  }
  .quickstart__toggle:hover, .quickstart__toggle:focus-visible {
    background: var(--rust);
    border-color: var(--rust);
    color: var(--cream); /* fixed, not theme-adaptive --paper — needs to stay light against the rust fill regardless of site theme */
  }
  .quickstart__toggle:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }

  /* The /get-started page's big centered button: a long rest at rust,
     then a quick pop to cream with a subtle scale-up (data-blink-phase,
     timed asymmetrically by JS — see script) to draw the eye, and
     hovering always shows the INVERSE of whichever phase it's currently
     in, frozen there since the script also pauses the cycle on
     hover/focus. --rust/--cream (not --paper) because this needs to
     look the same regardless of the page's light/dark theme.

     max-height: the base .quickstart__toggle caps at 60px for the small
     homepage button's own collapse animation — this button's bigger
     padding/font needs ~74px of natural height, so 60px was clipping
     the bottom of the label and pushing the text visually off-centre. */
  .quickstart__toggle--standalone {
    padding: var(--s-5) var(--s-8);
    font-size: var(--step-1);
    border-width: 2px;
    max-height: 100px;
    transform: scale(1);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
      border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      max-height var(--dur) var(--ease), opacity var(--dur-fast) var(--ease),
      padding var(--dur) var(--ease), border-width var(--dur) var(--ease);
  }
  .quickstart__toggle--standalone[data-blink-phase="a"] {
    transform: scale(1);
    background: var(--rust); border-color: var(--rust); color: var(--cream);
  }
  .quickstart__toggle--standalone[data-blink-phase="b"] {
    transform: scale(1.045);
    background: var(--cream); border-color: var(--rust); color: var(--rust);
  }
  .quickstart__toggle--standalone[data-blink-phase="a"]:hover,
  .quickstart__toggle--standalone[data-blink-phase="a"]:focus-visible {
    transform: scale(1);
    background: var(--cream); border-color: var(--rust); color: var(--rust);
  }
  .quickstart__toggle--standalone[data-blink-phase="b"]:hover,
  .quickstart__toggle--standalone[data-blink-phase="b"]:focus-visible {
    transform: scale(1);
    background: var(--rust); border-color: var(--rust); color: var(--cream);
  }

  /* The button dissolves into the merging surface rather than just vanishing
     — shrinks, fades, and loses its border in step with the surface's own
     background/padding transition (both var(--dur)), so the two reads as
     one fluid motion rather than two separate things happening. */
  .quickstart__surface--open .quickstart__toggle {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
