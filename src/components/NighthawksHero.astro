---
/**
 * NighthawksHero.astro — interactive painting hero for CoversFlow.co
 *
 * Ships zero framework JS: hover/focus state is one dataset write, all visual
 * change is CSS. Drop in src/components/, put the painting in src/assets/,
 * import tokens.css once from your layout.
 *
 * Geometry contract (IMPORTANT): every % below is a percentage of the STAGE
 * BOX, and the stage box is locked to the painting's 16:9 ratio. If you let
 * the box drift off-ratio, object-fit:cover crops the image and every hotspot
 * points at the wrong paint. Do not add max-height to .stage.
 */
import { Image } from 'astro:assets';
import painting from '../assets/nighthawks.jpg';

const spaces = [
  {
    id: 'sign', n: '01', title: 'Brand Visibility', href: '/brand-visibility',
    blurb: 'The sign is what the street reads first. Own the name before anyone types a keyword.',
    tags: ['Branded SERP', 'AI answer engines', 'Entity & knowledge panel'],
    clip: 'polygon(31.2% 0%, 90.8% 0.2%, 90.8% 4.2%, 31.2% 15.7%)',
    svg: '<polygon points="31.2,0 90.8,0.2 90.8,4.2 31.2,15.7" />',
    origin: '61% 0%', bubble: { left: '44%', top: '15.5%' }, card: { left: '32%', top: '23%' },
  },
  {
    id: 'street', n: '02', title: 'Competitive Gaps', href: '/competitive-gaps',
    blurb: 'The rooms across the street went dark. We map what they stopped ranking for, and take it.',
    tags: ['Keyword gap audit', 'Content teardown', 'Market share of search'],
    clip: 'inset(25% 68.5% 38% 0% round 0 8px 8px 0)',
    svg: '<rect x="-1" y="25" width="32.5" height="37" />',
    origin: '8% 43%', bubble: { left: '12%', top: '38%' }, card: { left: '2%', bottom: '5%' },
  },
  {
    id: 'alone', n: '03', title: 'Discovery', href: '/discovery',
    blurb: "The guest with his back turned hasn't found you yet. Everything upstream of the booking.",
    tags: ['Near-me intent', 'Editorial & guides', 'Digital PR'],
    clip: 'ellipse(7.5% 16% at 54.5% 60%)',
    svg: '<ellipse cx="54.5" cy="60" rx="7.5" ry="16" />',
    origin: '54.5% 60%', bubble: { left: '54.5%', top: '78%' }, card: { right: '55%', bottom: '7%' },
  },
  {
    id: 'couple', n: '04', title: 'Community', href: '/community',
    blurb: 'Two people at the same counter, a world apart. Closing that gulf is the work.',
    tags: ['Review conversations', 'Events & partnerships', 'Local link earning'],
    clip: 'ellipse(6.6% 10.5% at 70.3% 53%)',
    svg: '<ellipse cx="70.3" cy="53" rx="6.6" ry="10.5" />',
    origin: '70.3% 53%', bubble: { left: '70.3%', top: '35%' }, card: { right: '39%', top: '30%' },
  },
  {
    id: 'counter', n: '05', title: 'Front of House', href: '/front-of-house',
    blurb: 'The counterman is the whole service. Every surface a guest touches on the way in.',
    tags: ['Google Business Profile', 'Booking flow', 'Location pages'],
    clip: 'ellipse(6.8% 16% at 85.5% 57%)',
    svg: '<ellipse cx="85.5" cy="57" rx="6.8" ry="16" />',
    origin: '85.5% 57%', bubble: { left: '85.5%', top: '80%' }, card: { right: '25%', bottom: '7%' },
  },
  {
    id: 'door', n: '06', title: 'Back of House', href: '/back-of-house',
    blurb: 'Behind the door: the plumbing nobody sees and everything depends on.',
    tags: ['Menu & recipe schema', 'Site architecture', 'Core Web Vitals'],
    clip: 'ellipse(4.2% 18% at 93.5% 47%)',
    svg: '<ellipse cx="93.5" cy="47" rx="4.2" ry="18" />',
    origin: '93.5% 47%', bubble: { left: '92%', top: '22%' }, card: { right: '12.5%', bottom: '7%' },
  },
];

const pos = (o) => Object.entries(o).map(([k, v]) => `${k}:${v}`).join(';');

/* Per-hotspot rules. Static, but generated so geometry lives in ONE place. */
const css = spaces.map(p => `
  .pop--${p.id} { transform-origin: ${p.origin}; }
  .pop--${p.id} .pop__clip { clip-path: ${p.clip}; }
  .bubble--${p.id} { ${pos(p.bubble)}; }
  .card--${p.id}   { ${pos(p.card)}; }
  .stage[data-active="${p.id}"] .pop--${p.id} { opacity: 1; transform: scale(var(--pop-scale)); }
  .stage[data-active="${p.id}"] .pop--${p.id} .pop__clip { pointer-events: auto; }
  .stage[data-active="${p.id}"] .card--${p.id} { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .stage[data-active="${p.id}"] .bubble--${p.id} { filter: none; opacity: 1; }
  .stage[data-spotlight="${p.id}"] .bubble--${p.id} .bubble__ring {
    background: var(--lamp); border-color: var(--lamp); color: var(--night); font-weight: 700;
    animation: spotlight-ring-pulse 2s ease-in-out infinite, spotlight-glow 2s ease-in-out infinite;
  }
  .stage[data-spotlight="${p.id}"] .bubble--${p.id} .bubble__label {
    color: var(--lamp); font-weight: 700;
    animation: spotlight-label-pulse 2s ease-in-out infinite;
  }
  /* Same idle spotlight cycle driving the painting's bubbles also pulses
     the matching numbered jump-link in the panel — "in tandem" means
     literally the same data-spotlight attribute/timer, not a second
     independent cycle that happens to look similar. Its own (smaller)
     growth keyframe, not spotlight-ring-pulse — .intro__nums' fixed height
     stops the row itself from growing, but a smaller delta still reads
     calmer within that fixed space than the bubble's full-size pulse would. */
  .stage[data-spotlight="${p.id}"] ~ .intro .intro__num[data-hotspot="${p.id}"] {
    background: var(--lamp); border-color: var(--lamp); color: var(--night); font-weight: 700;
    animation: intro-num-spotlight-pulse 2s ease-in-out infinite, spotlight-glow 2s ease-in-out infinite;
  }
`).join('\n') + `
  /* Lives here (unscoped, via is:global below), not in the regular
     scoped <style> block — Astro appends a [data-astro-cid-*] attribute
     to every compound selector in a scoped block, which would inflate
     this rule's specificity past the per-id "un-blur the active one"
     rules above and make them lose regardless of source order. Keeping
     both in the same unscoped context keeps the specificity math
     (0,2,0 here vs 0,3,0 above) simple and reliable. */
  [data-active] .bubble { filter: blur(4px); opacity: .5; }
`;
---

<section class="hero">
  <div class="stage" data-stage>
    <div class="base"><Image src={painting} alt="Nighthawks by Edward Hopper" widths={[1200, 1800, 2400]} sizes="100vw" /></div>

    {spaces.map(p => (
      <div class={`pop pop--${p.id}`} aria-hidden="true">
        <div class="pop__clip"><Image src={painting} alt="" widths={[1200, 1800, 2400]} sizes="100vw" /></div>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="pop__outline" set:html={p.svg} />
      </div>
    ))}

    <div class="bubbles">
      {spaces.map(p => (
        <a
          href={p.href}
          class={`bubble bubble--${p.id}`}
          data-hotspot={p.id}
          transition:name={p.href === '/brand-visibility' ? 'space-hero' : undefined}
        >
          <span class="bubble__ring">{p.n}<span class="bubble__orbit"></span></span>
          <span class="bubble__label">{p.title}</span>
        </a>
      ))}
    </div>

    <div class="cards">
      {spaces.map(p => (
        <div class={`card card--${p.id}`}>
          <p class="card__head"><span class="card__n">{p.n}</span> {p.title}</p>
          <p class="card__blurb">{p.blurb}</p>
          <ul class="card__tags">{p.tags.map(t => <li>{t}</li>)}</ul>
          <a href={p.href} class="card__cta">Open the space →</a>
        </div>
      ))}
    </div>
  </div>

  {/* Sibling of .stage, not a child — .stage is locked to a strict 16:9 box
     (overflow:hidden; see the geometry contract up top), so this needs to
     live outside it to be free to grow taller than that box once it drops
     out of the floating-over-the-painting layout below 1200px. See the
     "detached dock" breakpoint below. */}
  <div class="intro">
    <div class="intro__glass" aria-hidden="true"></div>
    <div class="intro__content">
      <p class="intro__headline">Ranked. Reserved. Repeat.</p>
      <p class="intro__tagline">From Search to Seated.</p>
      <h1 class="intro__lede">CoversFlow is your SEO agency for hospitality</h1>
      <p class="intro__hint">Hover a figure to look closer</p>
      <ol class="intro__nums" aria-label="Jump to a space">
        {spaces.map(p => (
          <li><a href={p.href} class="intro__num" data-hotspot={p.id}>{p.n}</a></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global set:html={css}></style>

<style>
  /* --mx/--my/--sy live here, not on .stage: .intro__glass (the only
     consumer) is a descendant of .hero but a SIBLING of .stage, so a value
     written to .stage wouldn't inherit across that branch.

     padding-bottom is a real, reserved buffer in normal flow — not a
     scroll-triggered push. 170px of it is the straddle itself (roughly
     half .intro's own rendered height, so .intro lands half still over the
     painting, half hanging into this strip); --intro-gap on top of that is
     clear air AFTER .intro's own bottom edge, so QuickstartForm's "Not
     sure where you stand" doesn't sit flush against the box. Scales down
     on narrow viewports rather than staying a flat 200px everywhere. */
  .hero {
    background: var(--night); position: relative;
    --intro-gap: clamp(120px, 24vw, 200px);
    padding-bottom: calc(170px + var(--intro-gap));
    --mx: 0; --my: 0; --sy: 0;
  }

  /* Locked to the painting's ratio — see geometry contract above. */
  .stage {
    position: relative; margin: 0 auto; overflow: hidden;
    width: 100%; max-width: calc((100vh - 62px) * 16 / 9); aspect-ratio: 16 / 9;
    --blur: 7px; --pop-scale: 1.12;
  }
  .base, .pop { position: absolute; inset: 0; }
  .base :global(img), .pop :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .base { transition: filter var(--dur) ease; }
  .stage[data-active] .base { filter: blur(var(--blur)) saturate(.55) brightness(.5); }

  .pop {
    z-index: 10; opacity: 0; pointer-events: none; transform: scale(1);
    transition: transform .55s var(--ease), opacity .35s ease, filter var(--dur) ease;
  }
  .pop__clip { position: absolute; inset: 0; }
  .stage[data-active] .pop[style], .stage[data-active] .pop { filter: none; }
  .stage[data-active] .pop.is-on { filter: drop-shadow(0 18px 34px rgb(0 0 0 / .75)); }
  .pop__outline { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pop__outline :global(*) {
    /* --cream, not --paper: the hero is always dark regardless of site
       theme, so everything in it needs the fixed light cream rather than
       the theme-adaptive page token (which goes dark in dark mode). */
    fill: none; stroke: var(--cream); stroke-width: 1.5px;
    stroke-dasharray: 6 3 2 3; stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    animation: march 1.9s linear infinite;
  }
  @keyframes march { from { stroke-dashoffset: 0 } to { stroke-dashoffset: -28 } }

  /* pointer-events: none so the full-stage layer doesn't sit on top of the
     cutout's hit area — only the bubbles themselves catch the mouse. */
  .bubbles { position: absolute; inset: 0; z-index: 20; pointer-events: none; }
  .bubble {
    position: absolute; transform: translate(-50%, -50%); pointer-events: auto;
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    text-decoration: none; color: var(--cream); font-family: var(--font-body);
    filter: none; opacity: 1;
    transition: filter var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  /* Blur-others-while-one-is-active lives in the unscoped is:global
     block above (with the per-id "un-blur the active one" rules it
     needs to lose specificity to) — see the comment there for why. */
  .bubble:focus-visible { outline: 2px solid var(--cream); outline-offset: 6px; border-radius: 4px; }
  .bubble__ring {
    position: relative; display: grid; place-items: center;
    width: 38px; height: 38px; border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--cream) 60%, transparent); background: rgb(22 40 60 / .3);
    backdrop-filter: blur(3px);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em;
    /* width/height, not transform:scale() — scaling a box via transform
       stretches its already-rasterized text layer (blurry, "cheap"
       looking), where animating the actual box size keeps the number
       crisp since it's genuinely laid out at each size, never stretched. */
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease), width var(--dur-fast) var(--ease), height var(--dur-fast) var(--ease);
  }
  /* Deliberate hover/focus — grows and turns bright cream, distinct from
     the ambient lamp-yellow spotlight cycle so the two read as separate
     cues (idle attention vs. active interaction). Hovering a hotspot
     already calls stopSpotlight() in script, so the two never actually
     overlap in practice. */
  .bubble:hover .bubble__ring, .bubble:focus-visible .bubble__ring {
    background: var(--cream); border-color: var(--cream); color: var(--night);
    width: 49px; height: 49px;
  }
  .bubble:hover .bubble__label, .bubble:focus-visible .bubble__label {
    color: var(--cream);
  }
  .bubble__orbit {
    position: absolute; inset: -6px; border-radius: 50%;
    border: 1px dashed var(--ochre); opacity: .65;
    animation: spin 26s linear infinite;
  }
  .bubble--street .bubble__orbit { animation-delay: -4s }
  .bubble--alone  .bubble__orbit { animation-delay: -8s }
  .bubble--couple .bubble__orbit { animation-delay: -12s }
  .bubble--counter .bubble__orbit { animation-delay: -16s }
  .bubble--door   .bubble__orbit { animation-delay: -20s }
  @keyframes spin { to { transform: rotate(360deg) } }
  /* Idle attention-cycle highlight (data-spotlight, set in script below):
     a solid, bright --lamp fill rather than just a border/text colour
     shift — the previous version (rust border + rust text on the same
     translucent navy fill) didn't read as a clear "highlight" against
     busy painting detail behind it, particularly over the door/back-of-
     house spot. A solid fill plus a slow pulse reads clearly regardless
     of what's behind it. The ring pulses via width/height and the label
     via font-size — not transform:scale() on a wrapping element — for
     the same reason the hover-grow above avoids it: scaling a box
     (rather than genuinely resizing it) stretches already-rasterized
     text and looks blurry/"cheap" rather than crisp. */
  @keyframes spotlight-ring-pulse {
    0%, 100% { width: 38px; height: 38px; }
    50% { width: 46px; height: 46px; }
  }
  @keyframes spotlight-label-pulse {
    0%, 100% { font-size: 10.5px; }
    50% { font-size: 12.5px; }
  }
  @keyframes spotlight-glow {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--lamp) 55%, transparent); }
    50% { box-shadow: 0 0 16px 6px color-mix(in srgb, var(--lamp) 40%, transparent); }
  }
  .bubble__label {
    font-size: 10.5px; letter-spacing: var(--tracking-caps); text-transform: uppercase;
    white-space: nowrap; padding: 2px 6px; border-radius: var(--radius-sm);
    background: rgb(22 40 60 / .85);
    transition: color var(--dur-fast) var(--ease);
  }

  .cards { position: absolute; inset: 0; z-index: 30; pointer-events: none; }
  .card {
    position: absolute; width: 296px; padding: var(--s-4);
    background: rgb(22 40 60 / .93); border: 1px dashed var(--cream-3);
    border-radius: var(--radius-sm); color: var(--cream);
    opacity: 0; transform: translateY(8px); pointer-events: none;
    transition: opacity .3s ease, transform var(--dur) var(--ease);
  }
  .card__head { margin: 0 0 6px; font-family: var(--font-display); font-size: 19px; letter-spacing: var(--tracking-tight); }
  .card__n { font-family: var(--font-mono); font-size: 11px; color: var(--ochre); letter-spacing: .1em; margin-right: 4px; }
  .card__blurb { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: var(--cream-2); text-wrap: pretty; }
  .card__tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 12px; padding: 0; list-style: none; }
  .card__tags li {
    font-size: 10.5px; padding: 3px 8px; border: 1px dashed var(--cream-3);
    border-radius: var(--radius-sm); color: var(--cream-2);
    text-transform: uppercase; letter-spacing: .07em;
  }
  .card__cta { font-size: 12.5px; color: var(--lamp); text-decoration: none; border-bottom: 1px solid transparent; }
  .card__cta:hover { border-bottom-color: var(--lamp); }

  .intro {
    /* Left, not centered — centered sat right on top of hotspot #3
       (Discovery). bottom:var(--intro-gap) lands the panel straddling the
       painting's bottom edge (the fixed 170px baked into .hero's
       padding-bottom above is the straddle itself), with --intro-gap of
       clear air below the panel's own bottom edge before QuickstartForm's
       text starts. */
    position: absolute; left: 5%; bottom: var(--intro-gap); z-index: 35; pointer-events: none;
    max-width: 380px; padding: var(--s-5) var(--s-6);
    transform: translateY(0);
    transition: opacity .35s ease;
    /* Plays once automatically on mount — no JS needed to start it, only to
       react once it ends (script below). Both it and the full painting stay
       visible throughout: this never leaves .hero's own box, unlike the
       earlier scroll-linked version which docked the panel below the image
       in document flow — by the time that had scrolled into view the hero
       itself was gone, which defeated the point. */
    animation: intro-enter .9s cubic-bezier(.33, 0, .2, 1) both;
  }
  /* Settled = the one-time entrance has finished — the whole panel (not
     just .intro__nums) becomes clickable/selectable once it's done moving. */
  .intro.is-settled { pointer-events: auto; }
  /* Scoped to activeSource="painting" (set in script) — hovering the
     panel's OWN numbered links used to trigger this same fade, since both
     wrote the same stage[data-active]. Opacity only, no transform here —
     .intro's transform is owned by the entrance keyframes below; a second
     source fighting over the same property would conflict with whichever
     currently has priority. */
  /* pointer-events: none alongside the fade — opacity:0 alone only stops
     painting, not hit-testing. Without this, the now-invisible panel (still
     pointer-events:auto via .is-settled, still z-index:35, above .card's 30
     and .pop's 10) kept intercepting the mouse before it reached whichever
     card/cutout was trying to reveal underneath it — exactly the #2/#3
     hotspots, whose card positions now overlap the left-justified panel. */
  .stage[data-active-source="painting"] ~ .intro { opacity: 0; pointer-events: none; }
  /* .intro__nums opts back INTO pointer-events:auto on its own (needed so
     the numbered links are clickable while the panel is otherwise
     none-by-default) — that opt-in outranks the blanket none above by
     specificity, so it has to be re-silenced explicitly here too, or the
     (invisible) numbered-links row keeps intercepting the mouse on its own
     even once the rest of the panel correctly gets out of the way. This is
     exactly what was still blocking hotspot #2's card. */
  .stage[data-active-source="painting"] ~ .intro .intro__nums { pointer-events: none; }
  @keyframes intro-enter {
    0%   { transform: translateY(-42vh); }
    55%  { transform: translateY(22px); }  /* overcorrect down */
    80%  { transform: translateY(-5px); }  /* small pop back up past rest */
    100% { transform: translateY(0); }     /* settle exactly in place */
  }
  /* Visually this is the big poster line, but "Ranked. Reserved. Repeat."
     carries no searchable keywords — the actual <h1> below is the sentence
     that describes what CoversFlow does, kept at body-copy size. Tag and
     visual size are deliberately decoupled here for SEO; see intro__lede. */
  .intro .intro__headline {
    margin: 0 0 10px; font-family: var(--font-display); font-size: calc(var(--step-4) * .9);
    line-height: 1.02; letter-spacing: var(--tracking-tight); max-width: 9ch;
    color: var(--cream); text-shadow: 0 2px 24px rgb(0 0 0 / .85);
  }
  .intro p, .intro .intro__lede {
    margin: 0 0 6px; font-size: 14.5px; font-family: var(--font-body);
    font-weight: 400; letter-spacing: normal; line-height: 1.5;
    color: var(--cream-2); text-shadow: 0 1px 14px rgb(0 0 0 / .9);
  }
  /* Comes after (and repeats the .intro ancestor) so it outweighs .intro p's
     specificity above — otherwise that rule's color wins the cascade. Same
     "block lettering" treatment as SiteMenu's ONE ROOM panel__title
     (transparent fill, stroked outline) at every width, not just the
     detached dock state below — the solid-rust fill it used to have read
     as too faint against the painting to be legible. */
  .intro .intro__tagline {
    margin: 0 0 10px; font-family: var(--font-display); font-weight: 700;
    font-size: var(--step-2); letter-spacing: .03em;
    color: transparent; -webkit-text-stroke: 1.4px var(--rust);
    /* filter:drop-shadow, not text-shadow — it rasterizes against the
       glyphs' actual painted alpha (stroke included), so it hugs the
       OUTSIDE of each letterform rather than a flat offset blur behind the
       bounding box. Two passes: a near-opaque tight one for a crisp edge
       against the painting's own colour, a wider soft one that darkens the
       general area behind the word so it reads as a block even over busy
       detail. This was the actual fix for "illegible over the photo" —
       the earlier thin stroke alone wasn't enough contrast on its own. */
    filter:
      drop-shadow(0 1px 1.5px rgb(0 0 0 / .9))
      drop-shadow(0 0 10px rgb(0 0 0 / .7));
  }
  /* Shimmering slab-serif caption — the plain mono label it replaced read as
     an afterthought next to the poster-weight headline/tagline above it.
     Arvo (the accordion panel's "mid-century slab serif") plus an animated
     gradient sweep gives it its own presence instead of disappearing. */
  .intro__hint {
    font-family: var(--font-accordion); font-weight: 700;
    font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase;
    background: linear-gradient(90deg, var(--ochre) 0%, var(--lamp) 50%, var(--ochre) 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: hint-shimmer 3s linear infinite;
  }
  @keyframes hint-shimmer {
    from { background-position: 0% 0; }
    to { background-position: -220% 0; }
  }
  /* One-shot flash layered on top of the ambient shimmer the instant the
     panel's entrance settles — a "ta-da, look here" beat timed with the
     pop landing, not just the continuous background sweep running the
     whole time. Triggered in script via .is-gleaming once .intro's
     entrance animationend fires. */
  @keyframes hint-gleam {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.9) saturate(1.3); }
  }
  .intro__hint.is-gleaming {
    animation: hint-shimmer 3s linear infinite, hint-gleam .7s ease-out;
  }

  /* Numbered jump-links mirroring the bubble__ring badges on the painting
     itself — same data-hotspot hook, so hovering/focusing one triggers the
     identical cutout + card reveal (see the script's shared, document-wide
     query for [data-hotspot], not just inside .stage). A second way in once
     the glass panel isn't sitting right next to the figures anymore. */
  /* Full width of the box, evenly spaced, not clustered at one end — and
     sized to match .bubble__ring (38px) rather than the original 26px,
     which was fiddly to keep the pointer on and made the row feel twitchy
     to use. */
  .intro__nums {
    display: flex; justify-content: space-between; align-items: center; width: 100%;
    /* Fixed, matching the largest any one circle ever grows to (hover or
       spotlight pulse) — without this, a circle growing via width/height
       grows this flex row's own height too, which reads as the whole panel
       "breathing" in and out as the idle spotlight cycles. The panel stays
       one constant size regardless of what any single circle is doing. */
    height: 44px;
    gap: 6px; margin: 14px 0 0; padding: 0; list-style: none;
    pointer-events: auto;
  }
  .intro__num {
    display: grid; place-items: center;
    width: 38px; height: 38px; border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--cream) 55%, transparent);
    background: rgb(22 40 60 / .3);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em;
    color: var(--cream-2); text-decoration: none;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease), width var(--dur-fast) var(--ease), height var(--dur-fast) var(--ease);
  }
  .intro__num:hover, .intro__num:focus-visible {
    background: var(--cream); border-color: var(--cream); color: var(--night);
    width: 44px; height: 44px;
  }
  .intro__num:focus-visible { outline: 2px solid var(--cream); outline-offset: 3px; }
  /* Smaller delta than the painting's spotlight-ring-pulse (38→46) — this
     one plays inside a fixed-height row (see .intro__nums), so a quieter
     grow reads as a calm highlight rather than the row visibly flexing. */
  @keyframes intro-num-spotlight-pulse {
    0%, 100% { width: 38px; height: 38px; }
    50% { width: 42px; height: 42px; }
  }

  .intro__content { position: relative; z-index: 2; }

  /* Frosted panel behind the intro text so it reads over busy paint detail
     instead of sitting directly on it. Lives inside .intro so the existing
     .stage[data-active] .intro fade (above) hides text + glass together —
     no separate show/hide logic needed. Bleeds past the text column for a
     panel look, confined to this corner rather than full-bleed. */
  .intro__glass {
    position: absolute; z-index: 1;
    inset: -20px -24px;
    border-radius: 14px; /* intentionally softer than the site's poster-squared --radius-sm/md — the one soft shape in this hero */
    overflow: hidden;
    /* Gradient-border trick: border-color can't take a gradient directly,
       so two background layers do it instead — one clipped to padding-box
       for the actual fill, one clipped to border-box (showing only in the
       transparent border's width) carrying a top-bright/bottom-faint white
       gradient, so the edge reads as glass catching light from above. */
    border: 1px solid transparent;
    background:
      linear-gradient(rgb(22 40 60 / .07), rgb(22 40 60 / .07)) padding-box,
      linear-gradient(180deg, rgb(255 255 255 / .55), rgb(255 255 255 / .05)) border-box;
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / .18),
      0 10px 30px rgb(0 0 0 / .3),
      0 2px 8px rgb(0 0 0 / .2);
    transition: opacity .35s ease, transform var(--dur) ease;
    transform: translate3d(
      calc(var(--mx, 0) * 6px),
      calc(var(--my, 0) * 6px + var(--sy, 0) * 12px),
      0
    );
    will-change: transform;
  }
  /* Ambient "liquid" idle motion: a sheen sweep on ::before, not an
     animated backdrop-filter (which would force a blur recompute/frame). */
  .intro__glass::before {
    content: '';
    position: absolute; inset: -40%;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / .08) 50%, transparent 65%);
    animation: glass-sheen 9s ease-in-out infinite;
  }
  @keyframes glass-sheen {
    0%, 100% { transform: translate(-20%, -6%); opacity: .5; }
    50%      { transform: translate(10%, 6%);  opacity: .9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble__orbit, .pop__outline :global(*), .intro__glass::before, .intro__hint { animation: none; }
    .pop, .base, .card, .intro, .intro__glass, .bubble { transition-duration: .01ms; }
    .intro__glass { transform: none; }
    .intro__hint { background-position: 0 0; }
    /* Keep the bright lamp-fill highlight itself (it's the state change
       that matters for noticing the hotspots) but drop the pulsing
       ring/label/glow loops — see spotlight-ring-pulse/spotlight-label-
       pulse/spotlight-glow above. */
    .bubble__ring, .bubble__label { animation: none !important; }
    /* Entrance pop and the synced circle pulse are both motion reduced-
       motion should skip — script also short-circuits straight to the
       settled state (see astro:page-load below) rather than waiting for an
       animationend that will never fire once this cancels the animation. */
    .intro, .intro__num { animation: none !important; }
  }
  /* Below the ratio where hotspots stay legible, drop the painting to a flat
     backdrop and let the space grid below the hero carry navigation. The
     panel's own position is no longer width-gated at all (see .intro's base
     rule and the scroll-driven entrance in script below) — this block is
     purely about hotspot interactivity, which still doesn't make sense on
     touch/narrow. */
  @media (max-width: 780px), (hover: none) {
    .bubbles, .cards, .pop { display: none; }
    .intro { padding: var(--s-6) var(--s-5); max-width: 40ch; margin: 0; }
    .intro__glass { display: none; }
    .intro__nums { display: none; }
    /* Nothing left to hover at this width — the hint instructing visitors
       to do so would be actively misleading, not just redundant. */
    .intro__hint { display: none; }
  }
</style>

<script>
  /* astro:page-load, not top-level: this component's script only executes
     once per session (ES module caching) even though ClientRouter lets a
     visitor return to "/" many times via soft navigation. Re-binding on
     every page-load event (fired for the initial load too) is what makes
     the hover interaction work again on a revisit, not just the first. */
  document.addEventListener('astro:page-load', () => {
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (!stage) return;
    const hero = stage.closest<HTMLElement>('.hero');
    if (!hero) return;
    const intro = hero.querySelector<HTMLElement>('.intro');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;

    /* Idle attention-cycle: highlights one numbered bubble at a time (color
       + bold, via data-spotlight) so first-time visitors notice the hotspots
       are interactive before ever hovering one. Paused during real hover and
       while off-screen; disabled entirely under reduced motion. */
    const hotspots = Array.from(stage.querySelectorAll('[data-hotspot]')).map((el) => el.dataset.hotspot);
    let spotlightTimer = null;
    let spotlightIdx = -1;
    const SPOTLIGHT_MS = 3400;

    function spotlightNext() {
      spotlightIdx = (spotlightIdx + 1) % hotspots.length;
      stage.dataset.spotlight = hotspots[spotlightIdx];
    }
    function startSpotlight() {
      if (spotlightTimer || reduceMotion.matches) return;
      spotlightNext();
      spotlightTimer = setInterval(spotlightNext, SPOTLIGHT_MS);
    }
    function stopSpotlight() {
      clearInterval(spotlightTimer);
      spotlightTimer = null;
      delete stage.dataset.spotlight;
    }

    /* The active hotspot's bubble, surfaced cutout and card form ONE hover
       zone (the clip-path also clips hit-testing, so the cutout only catches
       the mouse inside its shape). Leaving the zone dismisses after a grace
       delay; entering any bubble switches immediately. */
    const LINGER_MS = 400;
    let timer = null;
    const cancel = () => { clearTimeout(timer); timer = null; };
    const set = (v, fromIntro = false) => {
      cancel();
      if (v) {
        stage.dataset.active = v;
        stage.dataset.activeSource = fromIntro ? 'intro' : 'painting';
        stopSpotlight();
      } else {
        delete stage.dataset.active;
        delete stage.dataset.activeSource;
        if (inView) startSpotlight();
      }
    };
    const linger = () => { cancel(); timer = setTimeout(() => set(null), LINGER_MS); };

    /* document-wide, not stage-scoped: the .intro__nums jump-links now live
       outside .stage (see the markup comment above), so binding only within
       stage would miss them. Each element's own closest('.intro') at bind
       time (not per-hover) marks whether it's one of the panel's own links
       — only painting-sourced hovers fade the panel (see the CSS fade rule;
       hovering the panel's own links used to make the panel containing them
       disappear). */
    document.querySelectorAll('[data-hotspot]').forEach((el) => {
      const id = (el as HTMLElement).dataset.hotspot;
      const fromIntro = !!el.closest('.intro');
      el.addEventListener('pointerenter', () => set(id, fromIntro));
      el.addEventListener('focus', () => set(id, fromIntro));
      el.addEventListener('pointerleave', linger);
    });
    stage.querySelectorAll('.pop__clip, .card').forEach((el) => {
      el.addEventListener('pointerenter', cancel);
      el.addEventListener('pointerleave', linger);
    });
    stage.addEventListener('pointerleave', linger);
    stage.addEventListener('focusout', (e) => {
      if (!stage.contains(e.relatedTarget as Node | null)) set(null);
    });

    /* The panel's entrance (CSS animation, see .intro's base rule) plays
       automatically on mount — this just reacts once it finishes: flips on
       pointer-events, and fires a one-shot "gleam" flash on the hint text,
       landing right as the pop settles. Under reduced motion the CSS
       cancels that animation outright (see the media block above), so
       there's no animationend to wait for — jump straight to the settled
       state instead. */
    if (intro) {
      const settleIntro = () => {
        intro.classList.add('is-settled');
        const hint = intro.querySelector<HTMLElement>('.intro__hint');
        if (hint && !reduceMotion.matches) {
          hint.classList.add('is-gleaming');
          hint.addEventListener('animationend', () => hint.classList.remove('is-gleaming'), { once: true });
        }
      };
      if (reduceMotion.matches) {
        settleIntro();
      } else {
        intro.addEventListener('animationend', (e: AnimationEvent) => {
          if (e.target === intro && e.animationName === 'intro-enter') settleIntro();
        });
      }
    }

    /* Only run the spotlight cycle and scroll-parallax loop while the hero
       is near/in view — cheap to gate, no reason to tick either off-screen. */
    let scrollRaf = 0;
    const startScrollLoop = () => {
      if (scrollRaf || reduceMotion.matches) return;
      const tick = () => {
        if (!inView) { scrollRaf = 0; return; }
        const r = stage.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const progress = ((vh / 2) - (r.top + r.height / 2)) / (vh / 2);
        hero.style.setProperty('--sy', progress.toFixed(3));
        scrollRaf = requestAnimationFrame(tick);
      };
      scrollRaf = requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !stage.dataset.active) startSpotlight();
      if (inView) startScrollLoop();
    }, { rootMargin: '20% 0px' });
    io.observe(stage);

    /* Glass-panel mouse parallax: cursor position within .stage, normalized
       -1..1, rAF-throttled — same shape as SiteMenu.astro's --mx/--my. Only
       .intro__glass's transform reads these, so the text itself never moves. */
    if (!reduceMotion.matches) {
      let raf = 0;
      const point = { x: 0, y: 0 };
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        point.x = ((e.clientX - r.left) / r.width - 0.5) * 2;
        point.y = ((e.clientY - r.top) / r.height - 0.5) * 2;
        if (!raf) {
          raf = requestAnimationFrame(() => {
            raf = 0;
            hero.style.setProperty('--mx', point.x.toFixed(3));
            hero.style.setProperty('--my', point.y.toFixed(3));
          });
        }
      });
      stage.addEventListener('pointerleave', () => {
        hero.style.setProperty('--mx', '0');
        hero.style.setProperty('--my', '0');
      });
    }
  });
</script>
