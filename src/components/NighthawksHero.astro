---
/**
 * NighthawksHero.astro — interactive painting hero for CoversFlow.co
 *
 * Ships zero framework JS: hover/focus state is one dataset write, all visual
 * change is CSS. Drop in src/components/, put the painting in src/assets/,
 * import tokens.css once from your layout.
 *
 * Geometry contract (IMPORTANT): every % below is a percentage of the STAGE
 * BOX, and the stage box is locked to the painting's 16:9 ratio. If you let
 * the box drift off-ratio, object-fit:cover crops the image and every hotspot
 * points at the wrong paint. Do not add max-height to .stage.
 */
import { Image } from 'astro:assets';
import painting from '../assets/nighthawks.jpg';

const spaces = [
  {
    id: 'sign', n: '01', title: 'Brand Visibility', href: '/brand-visibility',
    blurb: 'The sign is what the street reads first. Own the name before anyone types a keyword.',
    tags: ['Branded SERP', 'AI answer engines', 'Entity & knowledge panel'],
    clip: 'polygon(31.2% 0%, 90.8% 0.2%, 90.8% 4.2%, 31.2% 15.7%)',
    svg: '<polygon points="31.2,0 90.8,0.2 90.8,4.2 31.2,15.7" />',
    origin: '61% 0%', bubble: { left: '44%', top: '15.5%' }, card: { left: '32%', top: '23%' },
  },
  {
    id: 'street', n: '02', title: 'Competitive Gaps', href: '/competitive-gaps',
    blurb: 'The rooms across the street went dark. We map what they stopped ranking for, and take it.',
    tags: ['Keyword gap audit', 'Content teardown', 'Market share of search'],
    clip: 'inset(25% 68.5% 38% 0% round 0 8px 8px 0)',
    svg: '<rect x="-1" y="25" width="32.5" height="37" />',
    origin: '8% 43%', bubble: { left: '12%', top: '38%' }, card: { left: '34%', top: '30%' },
  },
  {
    id: 'alone', n: '03', title: 'Discovery', href: '/discovery',
    blurb: "The guest with his back turned hasn't found you yet. Everything upstream of the booking.",
    tags: ['Near-me intent', 'Editorial & guides', 'Digital PR'],
    clip: 'ellipse(7.5% 16% at 54.5% 60%)',
    svg: '<ellipse cx="54.5" cy="60" rx="7.5" ry="16" />',
    origin: '54.5% 60%', bubble: { left: '54.5%', top: '78%' }, card: { right: '55%', bottom: '7%' },
  },
  {
    id: 'couple', n: '04', title: 'Community', href: '/community',
    blurb: 'Two people at the same counter, a world apart. Closing that gulf is the work.',
    tags: ['Review conversations', 'Events & partnerships', 'Local link earning'],
    clip: 'ellipse(6.6% 10.5% at 70.3% 53%)',
    svg: '<ellipse cx="70.3" cy="53" rx="6.6" ry="10.5" />',
    origin: '70.3% 53%', bubble: { left: '70.3%', top: '38%' }, card: { right: '39%', top: '30%' },
  },
  {
    id: 'counter', n: '05', title: 'Front of House', href: '/front-of-house',
    blurb: 'The counterman is the whole service. Every surface a guest touches on the way in.',
    tags: ['Google Business Profile', 'Booking flow', 'Location pages'],
    clip: 'ellipse(6.8% 16% at 85.5% 57%)',
    svg: '<ellipse cx="85.5" cy="57" rx="6.8" ry="16" />',
    origin: '85.5% 57%', bubble: { left: '85.5%', top: '80%' }, card: { right: '25%', bottom: '7%' },
  },
  {
    id: 'door', n: '06', title: 'Back of House', href: '/back-of-house',
    blurb: 'Behind the door: the plumbing nobody sees and everything depends on.',
    tags: ['Menu & recipe schema', 'Site architecture', 'Core Web Vitals'],
    clip: 'ellipse(4.2% 18% at 93.5% 47%)',
    svg: '<ellipse cx="93.5" cy="47" rx="4.2" ry="18" />',
    origin: '93.5% 47%', bubble: { left: '92%', top: '24%' }, card: { right: '12.5%', bottom: '7%' },
  },
];

const pos = (o) => Object.entries(o).map(([k, v]) => `${k}:${v}`).join(';');

/* Per-hotspot rules. Static, but generated so geometry lives in ONE place. */
const css = spaces.map(p => `
  .pop--${p.id} { transform-origin: ${p.origin}; }
  .pop--${p.id} .pop__clip { clip-path: ${p.clip}; }
  .bubble--${p.id} { ${pos(p.bubble)}; }
  .card--${p.id}   { ${pos(p.card)}; }
  .stage[data-active="${p.id}"] .pop--${p.id} { opacity: 1; transform: scale(var(--pop-scale)); }
  .stage[data-active="${p.id}"] .pop--${p.id} .pop__clip { pointer-events: auto; }
  .stage[data-active="${p.id}"] .card--${p.id} { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .stage[data-spotlight="${p.id}"] .bubble--${p.id} {
    animation: spotlight-pulse 2s ease-in-out infinite;
  }
  .stage[data-spotlight="${p.id}"] .bubble--${p.id} .bubble__ring {
    background: var(--lamp); border-color: var(--lamp); color: var(--night); font-weight: 700;
    animation: spotlight-glow 2s ease-in-out infinite;
  }
  .stage[data-spotlight="${p.id}"] .bubble--${p.id} .bubble__label {
    color: var(--lamp); font-weight: 700;
  }
`).join('\n');
---

<section class="hero">
  <div class="stage" data-stage>
    <div class="base"><Image src={painting} alt="Nighthawks by Edward Hopper" widths={[1200, 1800, 2400]} sizes="100vw" /></div>

    {spaces.map(p => (
      <div class={`pop pop--${p.id}`} aria-hidden="true">
        <div class="pop__clip"><Image src={painting} alt="" widths={[1200, 1800, 2400]} sizes="100vw" /></div>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="pop__outline" set:html={p.svg} />
      </div>
    ))}

    <div class="bubbles">
      {spaces.map(p => (
        <a
          href={p.href}
          class={`bubble bubble--${p.id}`}
          data-hotspot={p.id}
          transition:name={p.href === '/brand-visibility' ? 'space-hero' : undefined}
        >
          <span class="bubble__ring">{p.n}<span class="bubble__orbit"></span></span>
          <span class="bubble__label">{p.title}</span>
        </a>
      ))}
    </div>

    <div class="cards">
      {spaces.map(p => (
        <div class={`card card--${p.id}`}>
          <p class="card__head"><span class="card__n">{p.n}</span> {p.title}</p>
          <p class="card__blurb">{p.blurb}</p>
          <ul class="card__tags">{p.tags.map(t => <li>{t}</li>)}</ul>
          <a href={p.href} class="card__cta">Open the space →</a>
        </div>
      ))}
    </div>

    <div class="intro">
      <div class="intro__glass" aria-hidden="true"></div>
      <div class="intro__content">
        <p class="intro__headline">Ranked. Reserved. Repeat.</p>
        <p class="intro__tagline">From Search to Seated.</p>
        <h1 class="intro__lede">CoversFlow is an SEO agency for hospitality. Six places to look, all of them in one room.</h1>
        <p class="intro__hint">Hover a figure to look closer</p>
      </div>
    </div>
  </div>
</section>

<style is:global set:html={css}></style>

<style>
  .hero { background: var(--night); }

  /* Locked to the painting's ratio — see geometry contract above. */
  .stage {
    position: relative; margin: 0 auto; overflow: hidden;
    width: 100%; max-width: calc((100vh - 62px) * 16 / 9); aspect-ratio: 16 / 9;
    --blur: 7px; --pop-scale: 1.12; --mx: 0; --my: 0; --sy: 0;
  }
  .base, .pop { position: absolute; inset: 0; }
  .base :global(img), .pop :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .base { transition: filter var(--dur) ease; }
  .stage[data-active] .base { filter: blur(var(--blur)) saturate(.55) brightness(.5); }

  .pop {
    z-index: 10; opacity: 0; pointer-events: none; transform: scale(1);
    transition: transform .55s var(--ease), opacity .35s ease, filter var(--dur) ease;
  }
  .pop__clip { position: absolute; inset: 0; }
  .stage[data-active] .pop[style], .stage[data-active] .pop { filter: none; }
  .stage[data-active] .pop.is-on { filter: drop-shadow(0 18px 34px rgb(0 0 0 / .75)); }
  .pop__outline { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pop__outline :global(*) {
    /* --cream, not --paper: the hero is always dark regardless of site
       theme, so everything in it needs the fixed light cream rather than
       the theme-adaptive page token (which goes dark in dark mode). */
    fill: none; stroke: var(--cream); stroke-width: 1.5px;
    stroke-dasharray: 6 3 2 3; stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    animation: march 1.9s linear infinite;
  }
  @keyframes march { from { stroke-dashoffset: 0 } to { stroke-dashoffset: -28 } }

  /* pointer-events: none so the full-stage layer doesn't sit on top of the
     cutout's hit area — only the bubbles themselves catch the mouse. */
  .bubbles { position: absolute; inset: 0; z-index: 20; pointer-events: none; }
  .bubble {
    position: absolute; transform: translate(-50%, -50%); pointer-events: auto;
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    text-decoration: none; color: var(--cream); font-family: var(--font-body);
  }
  .bubble:focus-visible { outline: 2px solid var(--cream); outline-offset: 6px; border-radius: 4px; }
  .bubble__ring {
    position: relative; display: grid; place-items: center;
    width: 38px; height: 38px; border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--cream) 60%, transparent); background: rgb(22 40 60 / .3);
    backdrop-filter: blur(3px);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  /* Deliberate hover/focus — grows and turns bright cream, distinct from
     the ambient lamp-yellow spotlight cycle so the two read as separate
     cues (idle attention vs. active interaction). Hovering a hotspot
     already calls stopSpotlight() in script, so the two never actually
     overlap in practice. */
  .bubble:hover .bubble__ring, .bubble:focus-visible .bubble__ring {
    background: var(--cream); border-color: var(--cream); color: var(--night);
    transform: scale(1.3);
  }
  .bubble:hover .bubble__label, .bubble:focus-visible .bubble__label {
    color: var(--cream);
  }
  .bubble__orbit {
    position: absolute; inset: -6px; border-radius: 50%;
    border: 1px dashed var(--ochre); opacity: .65;
    animation: spin 26s linear infinite;
  }
  .bubble--street .bubble__orbit { animation-delay: -4s }
  .bubble--alone  .bubble__orbit { animation-delay: -8s }
  .bubble--couple .bubble__orbit { animation-delay: -12s }
  .bubble--counter .bubble__orbit { animation-delay: -16s }
  .bubble--door   .bubble__orbit { animation-delay: -20s }
  @keyframes spin { to { transform: rotate(360deg) } }
  /* Idle attention-cycle highlight (data-spotlight, set in script below):
     a solid, bright --lamp fill rather than just a border/text colour
     shift — the previous version (rust border + rust text on the same
     translucent navy fill) didn't read as a clear "highlight" against
     busy painting detail behind it, particularly over the door/back-of-
     house spot. A solid fill plus a slow pulsing scale+glow reads
     clearly regardless of what's behind it. Split across two keyframes
     so the whole figure (ring + label) scales together as one unit —
     spotlight-pulse carries the scale (applied to .bubble--id, so it
     must also restate the base translate(-50%,-50%) centering, since
     transform is a single property) and spotlight-glow carries just the
     ring's box-shadow, kept separate so the glow doesn't get scaled
     twice by both the parent's and the ring's own transform. */
  @keyframes spotlight-pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.3); }
  }
  @keyframes spotlight-glow {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--lamp) 55%, transparent); }
    50% { box-shadow: 0 0 16px 6px color-mix(in srgb, var(--lamp) 40%, transparent); }
  }
  .bubble__label {
    font-size: 10.5px; letter-spacing: var(--tracking-caps); text-transform: uppercase;
    white-space: nowrap; padding: 2px 6px; border-radius: var(--radius-sm);
    background: rgb(22 40 60 / .6);
    transition: color var(--dur-fast) var(--ease);
  }

  .cards { position: absolute; inset: 0; z-index: 30; pointer-events: none; }
  .card {
    position: absolute; width: 296px; padding: var(--s-4);
    background: rgb(22 40 60 / .93); border: 1px dashed var(--cream-3);
    border-radius: var(--radius-sm); color: var(--cream);
    opacity: 0; transform: translateY(8px); pointer-events: none;
    transition: opacity .3s ease, transform var(--dur) var(--ease);
  }
  .card__head { margin: 0 0 6px; font-family: var(--font-display); font-size: 19px; letter-spacing: var(--tracking-tight); }
  .card__n { font-family: var(--font-mono); font-size: 11px; color: var(--ochre); letter-spacing: .1em; margin-right: 4px; }
  .card__blurb { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: var(--cream-2); text-wrap: pretty; }
  .card__tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 0 0 12px; padding: 0; list-style: none; }
  .card__tags li {
    font-size: 10.5px; padding: 3px 8px; border: 1px dashed var(--cream-3);
    border-radius: var(--radius-sm); color: var(--cream-2);
    text-transform: uppercase; letter-spacing: .07em;
  }
  .card__cta { font-size: 12.5px; color: var(--lamp); text-decoration: none; border-bottom: 1px solid transparent; }
  .card__cta:hover { border-bottom-color: var(--lamp); }

  .intro {
    position: absolute; left: 4%; bottom: 7%; z-index: 35; pointer-events: none;
    max-width: 330px; transition: opacity .35s ease, transform var(--dur) ease;
  }
  .stage[data-active] .intro { opacity: 0; transform: translateY(10px); }
  /* Visually this is the big poster line, but "Ranked. Reserved. Repeat."
     carries no searchable keywords — the actual <h1> below is the sentence
     that describes what CoversFlow does, kept at body-copy size. Tag and
     visual size are deliberately decoupled here for SEO; see intro__lede. */
  .intro .intro__headline {
    margin: 0 0 10px; font-family: var(--font-display); font-size: var(--step-4);
    line-height: 1.02; letter-spacing: var(--tracking-tight); max-width: 9ch;
    color: var(--cream); text-shadow: 0 2px 24px rgb(0 0 0 / .85);
  }
  .intro p, .intro .intro__lede {
    margin: 0 0 6px; font-size: 14.5px; font-family: var(--font-body);
    font-weight: 400; letter-spacing: normal; line-height: 1.5;
    color: var(--cream-2); text-shadow: 0 1px 14px rgb(0 0 0 / .9);
  }
  /* Comes after (and repeats the .intro ancestor) so it outweighs .intro p's
     specificity above — otherwise that rule's color wins the cascade. */
  .intro .intro__tagline {
    margin: 0 0 10px; font-family: var(--font-display); font-weight: 500;
    font-size: var(--step-1); letter-spacing: var(--tracking-tight);
    color: var(--rust); text-shadow: 0 2px 20px rgb(0 0 0 / .85);
  }
  .intro__hint { font-size: 11.5px; letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--ochre); }

  .intro__content { position: relative; z-index: 2; }

  /* Frosted panel behind the intro text so it reads over busy paint detail
     instead of sitting directly on it. Lives inside .intro so the existing
     .stage[data-active] .intro fade (above) hides text + glass together —
     no separate show/hide logic needed. Bleeds past the text column for a
     panel look, confined to this corner rather than full-bleed. */
  .intro__glass {
    position: absolute; z-index: 1;
    inset: -20px -24px;
    border-radius: 14px; /* intentionally softer than the site's poster-squared --radius-sm/md — the one soft shape in this hero */
    overflow: hidden;
    /* Gradient-border trick: border-color can't take a gradient directly,
       so two background layers do it instead — one clipped to padding-box
       for the actual fill, one clipped to border-box (showing only in the
       transparent border's width) carrying a top-bright/bottom-faint white
       gradient, so the edge reads as glass catching light from above. */
    border: 1px solid transparent;
    background:
      linear-gradient(rgb(22 40 60 / .07), rgb(22 40 60 / .07)) padding-box,
      linear-gradient(180deg, rgb(255 255 255 / .55), rgb(255 255 255 / .05)) border-box;
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / .18),
      0 10px 30px rgb(0 0 0 / .3),
      0 2px 8px rgb(0 0 0 / .2);
    transition: opacity .35s ease, transform var(--dur) ease;
    transform: translate3d(
      calc(var(--mx, 0) * 6px),
      calc(var(--my, 0) * 6px + var(--sy, 0) * 12px),
      0
    );
    will-change: transform;
  }
  /* Ambient "liquid" idle motion: a sheen sweep on ::before, not an
     animated backdrop-filter (which would force a blur recompute/frame). */
  .intro__glass::before {
    content: '';
    position: absolute; inset: -40%;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / .08) 50%, transparent 65%);
    animation: glass-sheen 9s ease-in-out infinite;
  }
  @keyframes glass-sheen {
    0%, 100% { transform: translate(-20%, -6%); opacity: .5; }
    50%      { transform: translate(10%, 6%);  opacity: .9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble__orbit, .pop__outline :global(*), .intro__glass::before { animation: none; }
    .pop, .base, .card, .intro, .intro__glass { transition-duration: .01ms; }
    .intro__glass { transform: none; }
    /* Keep the bright lamp-fill highlight itself (it's the state change
       that matters for noticing the hotspots) but drop the pulsing
       scale/glow loop — now split across the whole figure (.bubble) and
       the ring's own glow, see spotlight-pulse/spotlight-glow above. */
    .bubble, .bubble__ring { animation: none !important; }
  }
  /* Below the ratio where hotspots stay legible, drop the painting to a flat
     backdrop and let the space grid below the hero carry navigation. */
  @media (max-width: 780px), (hover: none) {
    .bubbles, .cards, .pop { display: none; }
    .intro { position: static; padding: var(--s-6) var(--s-5); max-width: 40ch; }
    .intro__glass { display: none; }
  }
</style>

<script>
  /* astro:page-load, not top-level: this component's script only executes
     once per session (ES module caching) even though ClientRouter lets a
     visitor return to "/" many times via soft navigation. Re-binding on
     every page-load event (fired for the initial load too) is what makes
     the hover interaction work again on a revisit, not just the first. */
  document.addEventListener('astro:page-load', () => {
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (!stage) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;

    /* Idle attention-cycle: highlights one numbered bubble at a time (color
       + bold, via data-spotlight) so first-time visitors notice the hotspots
       are interactive before ever hovering one. Paused during real hover and
       while off-screen; disabled entirely under reduced motion. */
    const hotspots = Array.from(stage.querySelectorAll('[data-hotspot]')).map((el) => el.dataset.hotspot);
    let spotlightTimer = null;
    let spotlightIdx = -1;
    const SPOTLIGHT_MS = 3400;

    function spotlightNext() {
      spotlightIdx = (spotlightIdx + 1) % hotspots.length;
      stage.dataset.spotlight = hotspots[spotlightIdx];
    }
    function startSpotlight() {
      if (spotlightTimer || reduceMotion.matches) return;
      spotlightNext();
      spotlightTimer = setInterval(spotlightNext, SPOTLIGHT_MS);
    }
    function stopSpotlight() {
      clearInterval(spotlightTimer);
      spotlightTimer = null;
      delete stage.dataset.spotlight;
    }

    /* The active hotspot's bubble, surfaced cutout and card form ONE hover
       zone (the clip-path also clips hit-testing, so the cutout only catches
       the mouse inside its shape). Leaving the zone dismisses after a grace
       delay; entering any bubble switches immediately. */
    const LINGER_MS = 400;
    let timer = null;
    const cancel = () => { clearTimeout(timer); timer = null; };
    const set = (v) => {
      cancel();
      v ? stage.dataset.active = v : delete stage.dataset.active;
      if (v) stopSpotlight();
      else if (inView) startSpotlight();
    };
    const linger = () => { cancel(); timer = setTimeout(() => set(null), LINGER_MS); };

    stage.querySelectorAll('[data-hotspot]').forEach((el) => {
      const id = el.dataset.hotspot;
      el.addEventListener('pointerenter', () => set(id));
      el.addEventListener('focus', () => set(id));
      el.addEventListener('pointerleave', linger);
    });
    stage.querySelectorAll('.pop__clip, .card').forEach((el) => {
      el.addEventListener('pointerenter', cancel);
      el.addEventListener('pointerleave', linger);
    });
    stage.addEventListener('pointerleave', linger);
    stage.addEventListener('focusout', (e) => {
      if (!stage.contains(e.relatedTarget as Node | null)) set(null);
    });

    /* Only run the spotlight cycle and scroll-parallax loop while the hero
       is near/in view — cheap to gate, no reason to tick either off-screen. */
    let scrollRaf = 0;
    const startScrollLoop = () => {
      if (scrollRaf || reduceMotion.matches) return;
      const tick = () => {
        if (!inView) { scrollRaf = 0; return; }
        const r = stage.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const progress = ((vh / 2) - (r.top + r.height / 2)) / (vh / 2);
        stage.style.setProperty('--sy', progress.toFixed(3));
        scrollRaf = requestAnimationFrame(tick);
      };
      scrollRaf = requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !stage.dataset.active) startSpotlight();
      if (inView) startScrollLoop();
    }, { rootMargin: '20% 0px' });
    io.observe(stage);

    /* Glass-panel mouse parallax: cursor position within .stage, normalized
       -1..1, rAF-throttled — same shape as SiteMenu.astro's --mx/--my. Only
       .intro__glass's transform reads these, so the text itself never moves. */
    if (!reduceMotion.matches) {
      let raf = 0;
      const point = { x: 0, y: 0 };
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        point.x = ((e.clientX - r.left) / r.width - 0.5) * 2;
        point.y = ((e.clientY - r.top) / r.height - 0.5) * 2;
        if (!raf) {
          raf = requestAnimationFrame(() => {
            raf = 0;
            stage.style.setProperty('--mx', point.x.toFixed(3));
            stage.style.setProperty('--my', point.y.toFixed(3));
          });
        }
      });
      stage.addEventListener('pointerleave', () => {
        stage.style.setProperty('--mx', '0');
        stage.style.setProperty('--my', '0');
      });
    }
  });
</script>
