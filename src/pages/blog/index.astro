---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { spaces } from '../../data/spaces';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const spaceTitleBySlug = Object.fromEntries(spaces.map((s) => [s.slug, s.title]));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
  ],
};
---

<Layout
  title="Blog | CoversFlow"
  description="Practical, specific guides on restaurant SEO — Google Business Profile, menu schema, reservations, and the technical plumbing that gets a hungry stranger seated."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="blog-index">
    <div class="mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="kicker">Blog</p>
    <h1>Where to look, written out</h1>
    <p class="lead">The specific, practical version of the work — not just what the six spaces cover, but how to actually do each piece yourself, or know when it's time to hand it off.</p>

    <ol class="blog-index__grid">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="post-card">
            <span class="post-card__date">
              {post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
            <span class="post-card__title">{post.data.title}</span>
            <span class="post-card__desc">{post.data.description}</span>
            {post.data.space && spaceTitleBySlug[post.data.space] && (
              <span class="post-card__tag">{spaceTitleBySlug[post.data.space]}</span>
            )}
          </a>
        </li>
      ))}
    </ol>
  </section>

  <p class="back-wrap"><a href="/" class="back">← Back to the diner</a></p>
</Layout>

<style>
  .blog-index {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
  }
  .kicker {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ochre);
  }
  h1 { margin: 0 0 var(--s-4); font-size: var(--step-3); }
  .lead { margin: 0 0 var(--s-6); font-size: var(--step-1); color: var(--ink-2); max-width: 62ch; }

  .blog-index__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  @media (max-width: 900px) { .blog-index__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .blog-index__grid { grid-template-columns: 1fr; } }

  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--s-4);
    border: 1px dashed var(--paper-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .post-card:hover, .post-card:focus-visible { border-color: var(--rust); }
  .post-card:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--s-2);
  }
  .post-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--s-2);
  }
  .post-card__desc {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
    flex-grow: 1;
  }
  .post-card__tag {
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--s-3);
    font-size: 10.5px;
    padding: 3px 8px;
    border: 1px dashed var(--paper-3);
    border-radius: var(--radius-sm);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: .07em;
  }

  .back-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--s-5) var(--s-8);
    text-align: center;
  }
  .back { color: var(--rust); text-decoration: none; font-size: var(--step--1); }
  .back:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
