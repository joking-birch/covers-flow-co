---
import Layout from '../layouts/Layout.astro';
import NighthawksHero from '../components/NighthawksHero.astro';
import QuickstartForm from '../components/QuickstartForm.astro';
import IntroLoader from '../components/IntroLoader.astro';
import SpaceDetail from '../components/SpaceDetail.astro';
import PricingAuditForm from '../components/PricingAuditForm.astro';
import OperatorStrip from '../components/OperatorStrip.astro';
import { spaces } from '../data/spaces';
import { plans, plansNote } from '../data/plans';

const title = 'CoversFlow — SEO & AI Search for Restaurants and Hospitality';
const description = 'Technical SEO, Google Business Profile, and AI-search visibility for independent restaurants and hospitality groups. A free audit shows where you stand.';

const steps = [
  {
    // Scope/target mark — looking closely before touching anything.
    icon: '<circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3.2" />',
    title: 'Walk the floor',
    body: 'We sit in your seat first: search results, maps, reviews, the menu online versus the one on the table. A full audit of what a hungry stranger actually sees before they ever call.',
  },
  {
    // Checkmark — work resolved.
    icon: '<path d="M5 12.5 9.5 17 19 7" />',
    title: "Fix what's broken",
    body: "Schema, speed, listings, the pages that should exist and don't. The unglamorous plumbing work, done once, done right.",
  },
  {
    // Simple light mark — "keep the lights on," also echoes --lamp (the diner's lit ceiling) elsewhere on this page.
    icon: '<circle cx="12" cy="12" r="5" /><line x1="12" y1="2" x2="12" y2="5.5" /><line x1="12" y1="18.5" x2="12" y2="22" /><line x1="2" y1="12" x2="5.5" y2="12" /><line x1="18.5" y1="12" x2="22" y2="12" />',
    title: 'Keep the lights on',
    body: 'Rankings move. Somebody opens across the street. We watch the map, adjust the work, and report in plain language.',
  },
];

const faqs = [
  {
    q: 'How is this different from a generic SEO agency?',
    a: 'We only work with restaurants and hospitality. The playbook, covering menus, maps, reviews, and foot traffic, is built for the room, not retrofitted from ecommerce.',
  },
  {
    q: 'How long before we see results?',
    a: 'Technical fixes and Google Business Profile changes can move within weeks. Rankings for competitive terms build over months. Anyone promising otherwise is selling something else.',
  },
  {
    q: 'Do you write the content, or just the strategy?',
    a: 'Both. We plan what needs to exist, then write it (pages, menus, location content) in a voice that sounds like the restaurant, not a template.',
  },
  {
    q: "Will this help with AI search, like ChatGPT or Google's AI Overviews?",
    a: 'Yes, it’s part of the same work. The signals that get a page ranked (clear structure, accurate facts, real authority) are largely the same ones that get it cited.',
  },
  {
    q: 'What size restaurant is this for?',
    a: 'One location or many, counter service or fine dining. The six spaces scale down or up; what changes is how much time each one gets.',
  },
  {
    q: 'Do we need to sign a long contract?',
    a: "CoversFlow is just getting off the ground, so terms are still being worked out. Reach out and we'll figure out what makes sense together.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <IntroLoader />

  <NighthawksHero />

  <QuickstartForm />

  <OperatorStrip />

  <section class="spaces">
    <div class="mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <h2>Six spaces to look</h2>
    <ol class="spaces__grid">
      {spaces.map((p) => (
        <li>
          <a href={`/${p.slug}`} class="space">
            <span class="space__n">{p.n}</span>
            <span class="space__title">{p.title}</span>
            <span class="space__blurb">{p.blurb}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="steps">
    <div class="mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <h2>How it works</h2>
    <ol class="steps__grid">
      {steps.map((s) => (
        <li class="step">
          <svg class="step__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
          <span class="step__title">{s.title}</span>
          <span class="step__body">{s.body}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="cta">
    <div class="cta__inner">
      <h2>Pull up a seat.</h2>
      <p>CoversFlow is just getting the lights on. Reach out and let's talk about what's actually happening in your search results.</p>
      <!-- Stand-in address: displays the coversflow.co brand address, actually delivers to ian@ianwhitewrites.com until that alias exists. -->
      <a class="btn" href="mailto:ian@ianwhitewrites.com">info@coversflow.co</a>
    </div>
  </section>

  <section class="pricing">
    <div class="mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <h2>What it costs</h2>

    <div class="pricing__seo">
      <p class="pricing__intro">If you already have a site and want it performing better, here's how CoversFlow prices ongoing SEO and AI-visibility work.</p>
      <p class="pricing__intro">Every engagement starts with a free website audit, free for now while CoversFlow is taking on founding clients. From there, we tailor a plan and price to your site, your market, and how much ground needs covering.</p>

      <div class="pricing__rate">
        <span class="pricing__rate-label">Typical for a single-location restaurant</span>
        <span class="pricing__rate-value">$500<span class="pricing__rate-dash">–</span>$1,200<span class="pricing__rate-unit">/mo</span></span>
        <p class="pricing__rate-caption">Final pricing is scoped after your free audit.</p>
        <PricingAuditForm />
      </div>
    </div>

    <h3 class="pricing__subhead">Website building &amp; design</h3>
    <p class="pricing__subhead-lede">Starting from scratch? Fixed-scope builds, priced up front:</p>

    <div class="pricing__grid">
      {plans.map((p) => (
        <div class="pricing__card">
          <span class="pricing__title">{p.title}</span>
          <span class="pricing__price">{p.price}</span>
          <span class="pricing__body">{p.body}</span>
        </div>
      ))}
    </div>
    <p class="pricing__note">{plansNote}</p>
    <a class="pricing__link" href="#get-started">Get started ↑</a>
  </section>

  <SpaceDetail />

  <section class="faq">
    <div class="mark" aria-hidden="true"><i></i><i></i><i></i></div>
    <h2>Frequently Asked Questions</h2>
    <div class="faq__list">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .spaces {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
  }
  .spaces h2 { margin: 0 0 var(--s-6); font-size: var(--step-3); }

  .spaces__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  @media (max-width: 900px) { .spaces__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .spaces__grid { grid-template-columns: 1fr; } }

  .space {
    display: block;
    height: 100%;
    padding: var(--s-4);
    border: 1px dashed var(--paper-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .space:hover, .space:focus-visible { border-color: var(--rust); }
  .space:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }

  .space__n {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--ochre);
    margin-bottom: var(--s-2);
  }
  .space__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--s-2);
  }
  .space:hover .space__title { text-decoration: underline; text-decoration-color: var(--rust); text-underline-offset: 4px; }
  .space__blurb {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  /* ── How it works ─────────────────────────────────────────────── */
  .steps {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--s-5) var(--s-8);
  }
  .steps h2 { margin: 0 0 var(--s-6); font-size: var(--step-3); }

  .steps__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  @media (max-width: 900px) { .steps__grid { grid-template-columns: 1fr; } }

  /* Idle: plain white card, barely there (just a hairline edge). Hover:
     rust fill (the site's one established "active" accent — every button
     already does this same rust-fill-on-hover), a diner-glass green
     border (the painting's own window-glass teal, already used elsewhere
     for edge accents — see tokens.css), and every piece of text inside
     flips to paper ("white") together. */
  .step {
    display: flex;
    flex-direction: column;
    padding: var(--s-5);
    background: var(--paper);
    border: 1px solid var(--paper-3);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .step:hover {
    background: var(--rust);
    border-color: var(--diner-glass);
  }
  .step__icon {
    width: 28px;
    height: 28px;
    color: var(--ochre);
    margin-bottom: var(--s-3);
    transition: color var(--dur-fast) var(--ease);
  }
  .step:hover .step__icon { color: var(--paper); }
  .step__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--s-2);
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease);
  }
  .step:hover .step__title { color: var(--paper); }
  .step__body {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
    transition: color var(--dur-fast) var(--ease);
  }
  .step:hover .step__body { color: var(--paper); }

  /* ── FAQ ─────────────────────────────────────────────────────── */
  .faq {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 var(--s-5) var(--s-8);
  }
  .faq h2 { margin: 0 0 var(--s-6); font-size: var(--step-3); }

  .faq__list { display: flex; flex-direction: column; gap: var(--s-3); }
  .faq__item {
    border: 1px dashed var(--paper-3);
    border-radius: var(--radius-sm);
    padding: var(--s-4);
  }
  .faq__item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: var(--tracking-tight);
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::before {
    content: '+';
    display: inline-block;
    width: 1em;
    color: var(--rust);
  }
  .faq__item[open] summary::before { content: '–'; }
  .faq__item summary:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }
  .faq__item p {
    margin: var(--s-3) 0 0 1em;
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  /* ── CTA banner ──────────────────────────────────────────────── */
  .cta { background: var(--paper-2); }
  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
    text-align: center;
  }
  .cta h2 { margin: 0 0 var(--s-3); font-size: var(--step-3); }
  .cta p {
    margin: 0 0 var(--s-5);
    font-size: var(--step-0);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .btn {
    display: inline-block;
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .btn:hover, .btn:focus-visible {
    background: var(--rust);
    border-color: var(--rust);
    color: var(--paper);
  }
  .btn:focus-visible { outline: 2px solid var(--rust); outline-offset: 2px; }

  /* ── Pricing ─────────────────────────────────────────────────── */
  .pricing {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
    text-align: center;
  }
  .pricing h2 { margin: 0 0 var(--s-6); font-size: var(--step-3); }

  .pricing__seo { max-width: 640px; margin: 0 auto var(--s-8); }
  .pricing__intro {
    margin: 0 0 var(--s-3);
    font-size: var(--step-0);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .pricing__intro:last-of-type { margin-bottom: var(--s-6); }

  .pricing__rate {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-6) var(--s-7);
    border: 2px solid var(--rust);
    border-radius: var(--radius-md);
  }
  .pricing__rate-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pricing__rate-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }
  .pricing__rate-dash { margin: 0 .1em; color: var(--ink-3); }
  .pricing__rate-unit { font-size: var(--step-0); font-weight: 500; color: var(--ink-2); margin-left: 2px; }
  .pricing__rate-caption { margin: 0; font-size: 12px; color: var(--ink-3); }

  .pricing__subhead {
    margin: 0 0 var(--s-2);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    letter-spacing: var(--tracking-tight);
  }
  .pricing__subhead-lede {
    margin: 0 0 var(--s-6);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
    margin-bottom: var(--s-3);
    text-align: left;
  }
  @media (max-width: 700px) { .pricing__grid { grid-template-columns: 1fr; } }

  .pricing__card {
    display: flex;
    flex-direction: column;
    padding: var(--s-4);
    border: 1px dashed var(--paper-3);
    border-radius: var(--radius-sm);
  }
  .pricing__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }
  .pricing__price {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--rust);
    margin: var(--s-1) 0 var(--s-2);
  }
  .pricing__body { font-size: var(--step--1); color: var(--ink-2); line-height: 1.5; }

  .pricing__note { margin: 0 0 var(--s-5); font-size: 12px; color: var(--ink-3); }
  .pricing__link { color: var(--rust); text-decoration: none; font-size: var(--step--1); }
  .pricing__link:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
