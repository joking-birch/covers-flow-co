---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteMenu from '../components/SiteMenu.astro';
import FlowMark from '../components/FlowMark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CoversFlow: SEO for hospitality',
  description = 'CoversFlow is an SEO agency for restaurants and hospitality. Six places to look, all of them in one room.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site">
    <header class="site-header">
      <a href="/" class="wordmark" data-header-logo>
        <span class="wordmark__covers">Covers</span>
        <FlowMark />
      </a>
      <SiteMenu />
    </header>
    <slot />
    <footer class="site-footer">
      <p>CoversFlow: SEO for hospitality</p>
      <p class="site-footer__meta">Ranked. Reserved. Repeat.</p>
    </footer>
    </div>
  </body>
</html>

<script>
  import Lenis from 'lenis';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* Lenis intercepts wheel/touch input to drive scroll smoothing itself, so
     reduced-motion needs a hard skip here rather than relying on its own
     respectReducedMotion option — that only short-circuits programmatic
     scrollTo() jumps (anchor links), not everyday wheel scrolling. Exposed
     on window so SiteMenu/IntroLoader can stop() it during their own
     scroll locks — overflow:hidden alone doesn't stop Lenis, since it
     drives scroll via JS regardless of CSS overflow. */
  if (!reduceMotion.matches) {
    const lenis = new Lenis({ autoRaf: true });
    (window as any).lenis = lenis;
  }

  const header = document.querySelector<HTMLElement>('.site-header');

  if (header && !reduceMotion.matches) {
    const THRESHOLD = 8; // px of scroll movement before reacting, ignores jitter
    const IDLE_MS = 200; // roll back down this long after scrolling stops
    let lastY = window.scrollY;
    let idleT: ReturnType<typeof setTimeout>;

    const show = () => header.classList.remove('site-header--hidden');
    const hide = () => header.classList.add('site-header--hidden');

    const onScroll = () => {
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= header.offsetHeight) {
        show();
      } else if (delta > THRESHOLD) {
        hide();
      } else if (delta < -THRESHOLD) {
        show();
      }

      lastY = y;
      clearTimeout(idleT);
      idleT = setTimeout(show, IDLE_MS);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /* Everything lives in a centered column; past 1600px the paper ground
     grows as side margins so ultra-wide windows don't stretch the layout. */
  .site { max-width: 1600px; margin: 0 auto; }

  /* 62px header height is load-bearing: NighthawksHero's stage max-width
     calc assumes it. Change both together or the hero over/undershoots.
     position: sticky keeps it in normal flow (unlike fixed/absolute), so
     that calc stays valid even though the header now stays pinned. */
  /* Sits above the menu overlay (z 50) so the burger stays clickable to
     close; the rule and wordmark fade out so the header reads as part of
     the overlay while it's open. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--s-5);
    background: var(--paper);
    border-bottom: 1px solid rgb(216 207 188 / calc(1 - var(--open)));
    /* No transform in the base state on purpose: SiteMenu's full-viewport
       overlay is position:fixed and lives inside this header in the DOM —
       any transform here (even translateY(0)) makes it a containing block,
       which traps that fixed overlay to the header's own box instead of the
       viewport. Only --hidden (below) sets one, while the header (and its
       burger toggle) is off-screen anyway. */
    transition: transform var(--dur-fast) var(--ease);
  }
  /* Tucked out of view while scrolling down; rolls back on scroll-up or
     once scrolling comes to rest (see the scroll listener below). */
  .site-header--hidden {
    transform: translateY(-100%);
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.16em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    text-decoration: none;
    opacity: calc(1 - var(--open));
    transition: opacity 400ms ease;
  }
  .wordmark__covers { display: block; }

  .site-footer {
    background: var(--night);
    color: var(--paper-2);
    padding: var(--s-6) var(--s-5);
  }
  .site-footer p { margin: 0; font-size: var(--step--1); }
  .site-footer__meta {
    color: var(--lamp);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-size: 11px;
    margin-top: var(--s-2);
  }
</style>
